<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian"
    android:orientation="vertical">

    <!-- ================= HEADER EJECUTIVO SUPERIOR ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIERNES • MARK-LV"
                android:textColor="@color/emerald_glow"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Listo para conectar"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSleepWake"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="44dp"
            android:paddingHorizontal="10dp"
            android:text="🌙 Reposo"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnConnectToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/emerald_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="⚡ CONECTAR"
            android:textColor="#04130D"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle" />

    <!-- ================= CONTENEDOR CENTRAL DE PESTAÑAS ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ==================== PESTAÑA 1: ASISTENTE NATIVO ==================== -->
        <LinearLayout
            android:id="@+id/viewAssistant"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!--Escenario Avatar 60 FPS + Chips Rápidos -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.46"
                android:background="@color/bg_obsidian">

                <WebView
                    android:id="@+id/avatarWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Chips flotantes superiores para funciones rápidas del celular -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnQuickTorch"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#99060A12"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="🔦 Linterna"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnQuickVision"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="#99060A12"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="10dp"
                        android:text="📷 Analizar Foto"
                        android:textColor="@color/emerald_glow"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stroke_subtle" />

            <!-- Panel de Conversación y Consola en Vivo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.54"
                android:background="@color/bg_panel"
                android:orientation="vertical">

                <ScrollView
                    android:id="@+id/chatScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:padding="12dp">

                    <LinearLayout
                        android:id="@+id/chatContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <!-- Banner de archivo o foto adjunta pendiente de envío -->
                <LinearLayout
                    android:id="@+id/attachmentBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvAttachmentName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="📎 archivo_adjunto.jpg"
                        android:textColor="@color/emerald_glow"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnClearAttachment"
                        style="?attr/borderlessButtonStyle"
                        android:layout_width="36dp"
                        android:layout_height="32dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="✕"
                        android:textColor="@color/danger_red"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Barra de Entrada Multimodal (Archivo + Cámara + Texto + Mic + Enviar) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_obsidian"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="8dp">

                    <Button
                        android:id="@+id/btnAttachFile"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="📎"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnCameraSnap"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="📷"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/etMessage"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@color/bg_input"
                        android:hint="Escribe o háblale a VIERNES..."
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnMicToggle"
                        android:layout_width="44dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/emerald_primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="🎙️"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnSendMessage"
                        android:layout_width="44dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="@color/cyan_accent"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="➤"
                        android:textColor="#04130D"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== PESTAÑA 2: ENLACE PC (CONTROL REMOTO) ==================== -->
        <LinearLayout
            android:id="@+id/viewPcLink"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_obsidian"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <EditText
                    android:id="@+id/etPcUrl"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@color/bg_input"
                    android:hint="http://192.168.100.23:8000"
                    android:inputType="textUri"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnLoadPcUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/emerald_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Conectar PC"
                    android:textColor="#04130D"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <WebView
                android:id="@+id/pcRemoteWebView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ==================== PESTAÑA 3: AJUSTES & VOCES ==================== -->
        <ScrollView
            android:id="@+id/viewSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_obsidian"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ CONFIGURACIÓN DE VIERNES MÓVIL"
                    android:textColor="@color/emerald_glow"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="Funciona 100% autónomo en tu Android con Gemini Live 2.5 y control de apps del teléfono."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- API Key de Gemini -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gemini API Key"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGeminiKey"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/bg_input"
                    android:hint="AIzaSy... o AQ..."
                    android:inputType="textVisiblePassword"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Identidad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nombre del Asistente"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etAssistantName"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/bg_input"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:text="Viernes"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tu Nombre"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etUserName"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:background="@color/bg_input"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:text="Jesús"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Motor de Voz -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Motor de Síntesis Vocal"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgTtsEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbEngineGemini"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="⚡ Gemini 2.5 Native Audio (Latencia Cero ~250ms)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbEngineElevenLabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎙️ ElevenLabs Flash v2.5 (PCM 24kHz Ultra-Rápido)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </RadioGroup>

                <!-- Voces HD de Gemini -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Voz Nativa de Gemini Live"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerGeminiVoice"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/bg_input"
                    android:paddingHorizontal="10dp" />

                <!-- Estilo / Personalidad de Voz -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estilo y Tono Vocal"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerVoiceStyle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/bg_input"
                    android:paddingHorizontal="10dp" />

                <!-- Configuración ElevenLabs -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ElevenLabs API Key (Opcional)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etElevenKey"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/bg_input"
                    android:hint="sk_..."
                    android:inputType="textVisiblePassword"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ElevenLabs Voice ID"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etElevenVoiceId"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/bg_input"
                    android:hint="XPvfYQ2tvMb3p1coSWGS"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/emerald_primary"
                    android:text="💾 GUARDAR Y APLICAR CAMBIOS"
                    android:textColor="#04130D"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Tarjeta informativa de comandos nativos en Android -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@color/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 COMANDOS DE VOZ NATIVOS EN ANDROID"
                        android:textColor="@color/cyan_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• &quot;Viernes, abre WhatsApp / YouTube / Spotify / Maps&quot;\n• &quot;Viernes, enciende la linterna del celular&quot;\n• &quot;Viernes, ¿cuánta batería tiene mi teléfono?&quot;\n• &quot;Viernes, sube el volumen al 80%&quot;\n• &quot;Viernes, pon una alarma a las 7:30 AM&quot;\n• &quot;Viernes, envía un WhatsApp al +52... diciendo hola&quot;\n• &quot;Viernes, analiza esta foto o documento adjunto&quot;"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_subtle" />

    <!-- ================= BARRA DE NAVEGACIÓN INFERIOR ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/bg_panel"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <Button
            android:id="@+id/tabBtnAssistant"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🤖 VIERNES"
            android:textColor="@color/emerald_glow"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabBtnPcLink"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="💻 Enlace PC"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tabBtnSettings"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙️ Ajustes"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
